{
  "notification.disabledProgressSources": [
    "*"
  ],
  "python.linting.flake8Enabled": true,
  "diagnostic.locationlistUpdate": true,
  "diagnostic.errorSign": "✘",
  "diagnostic.infoSign": "ℹ",
  "python.jediEnabled": false,
  "python.linting.mypyEnabled": true,
  "coc.preferences.promptInput": false,
  "biome.enable": false,
  "oxc.oxfmt.enable": true,
  "typescript.format.enable": false,
  "javascript.format.enable": false,
  "eslint.format.enable": false,
  "eslint.autoFixOnSave": false,
  "prettier.enable": false,
  "coc.source.file.ignoreHidden": false,
  "colors.enable": true,
  "codeLens.enable": false,
  "typescript.autoClosingTags": false,
  "diagnostic.showDeprecated": true,
  "coc.preferences.formatOnSave": true,
  "prettier.disableLanguages": [
    "markdown",
    "wiki"
  ],
  "tsserver.useLocalTsdk": true,
  "tsserver.maxTsServerMemory": 6072,
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.colorDecorators": false,
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html"
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "typescript.showUnused": false,
  "rust-analyzer.check.command": "clippy",
  "inlayHint.enable": false,
  "languageserver": {
    "bash": {
      "command": "bash-language-server",
      "args": [
        "start"
      ],
      "filetypes": [
        "sh",
        "zsh",
        "bash"
      ],
      "ignoredRootPaths": [
        "~"
      ]
    },
    "ocaml": {
      "command": "opam",
      "args": [
        "config",
        "exec",
        "--",
        "ocamllsp"
      ],
      "filetypes": [
        "ocaml"
      ]
    },
    "haskell": {
      "command": "haskell-language-server",
      "args": [
        "--lsp"
      ],
      "rootPatterns": [
        "*.cabal",
        "stack.yaml",
        "cabal.project",
        "package.yaml"
      ],
      "filetypes": [
        "haskell",
        "lhaskell"
      ],
      "initializationOptions": {
        "languageServerHaskell": {}
      }
    }
  },
  "Lua.hint.paramType": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": false,
    "source.fixAll.biome": false,
    "source.fixAll.eslint": false
  }
}
