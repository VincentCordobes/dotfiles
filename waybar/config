{
  "position": "top",
  // Choose the order of the modules
  "modules-left": [
    "sway/workspaces",
    // "hyprland/workspaces",
    "sway/mode"
    // "custom/media"
    /* "sway/window" */
  ],
  "modules-center": [],
  "modules-right": [
    "custom/recorder",
    "custom/watson",
    "mpris",
    "custom/multa",
    "tray",
    // "bluetooth", make waybar crash
    "idle_inhibitor",
    "custom/mako",
    "pulseaudio",
    "backlight",
    "temperature",
    // "wireplumber",
    "cpu",
    "memory",
    "network",
    "clock",
    "battery"
  ],
  // Modules configuration
  // "sway/workspaces": {
  //     "disable-scroll": true,
  //     "all-outputs": true,
  //     "format": "{name}: {icon}",
  //     "format-icons": {
  //         "1": "",
  //         "2": "",
  //         "3": "",
  //         "4": "",
  //         "5": "",
  //         "urgent": "",
  //         "focused": "",
  //         "default": ""
  //     }
  // },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/window": {
    "max-length": 30
  },
  "mpris": {
    "dynamic-len": 20,
    "format": " {player} ({status})",
    // "dynamic-order": ["title", "artist", "album"],
    "player-icons": {
      // "default": "▶"
      // "mpv": "🎵"
    },
    "status-icons": {
      // "paused": ""
    }
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 2,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "enabled": "",
      "disabled": ""
    },
    "tooltip-format": "{}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "today": "<span color='#ebcb8b'><b><u>{}</u></b></span>"
      }
    },
    "format-alt": " {:%Y-%m-%d}",
    "actions": {
      "on-click-right": "mode"
    }
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },
  "memory": {
    "format": " {}%",
    "interval": 2,
    "states": {
      "critical": 90,
      "warning": 80
    }
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "interval": 2,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": " {percent}%",
    "tooltip-format": "{percent}%"
    /* "on-click": "brightnessctl set 1%", */
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["", "", "", "", ""]
  },
  "network": {
    "interface": "wlp0s20f3",
    "interval": 2,
    "format-wifi": "",
    "tooltip-format-wifi": " {signalStrength}%",
    "format-alt": "⇵ {bandwidthDownOctets} {bandwidthUpOctets}",
    "format-ethernet": " {ifname}: {ipaddr}/{cidr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected"
  },
  // "wireplumber": {
  //   "format": "{icon} {volume}%",
  //   "format-muted": "",
  //   "on-click": "helvum",
  //   "format-icons": ["", "", ""]
  // },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{icon} {volume}%  {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "custom/multa": {
    "format": "{}",
    /* "return-type": "json", */
    "interval": 30,
    "signal": 8,
    "exec": "multa report | tail -n 1 | awk '{ if($1 == \"ko\") {printf \"%s·%s\\n%s\", $2,$4,$6}}'"
  },
  "custom/watson": {
    "format": " {}",
    /* "return-type": "json", */
    "on-click": "/home/vincent/.local/bin/watson stop",
    "exec-on-event": true,
    "interval": 30,
    "signal": 8,
    "exec": "sleep 0.2 && /home/vincent/scripts/waytson"
  },
  "custom/mako": {
    "exec": "~/dotfiles/mako/widget",
    "return-type": "json",
    "on-click": "if makoctl mode | grep -q disturb; then makoctl mode -r do-not-disturb; else makoctl mode -a do-not-disturb; fi; pkill -SIGRTMIN+8 waybar",
    "exec-on-event": true,
    "interval": 30,
    "signal": 8
  },
  "custom/github": {
    "exec": "$HOME/dotfiles/waybar/github-notifs",
    "on-click": "xdg-open https://github.com/notifications",
    "format": " {}",
    "return-type": "json",
    "interval": 60
  },
  "custom/recorder": {
    "format": "",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "exec": "echo '{\"class\": \"recording\"}'",
    "exec-if": "pgrep wf-recorder"
  }
  // "custom/media": {
  //   "format": "{icon} {}",
  //   "return-type": "json",
  //   "max-length": 40,
  //   "format-icons": {
  //     "spotify": "",
  //     "default": "🎜"
  //   },
  //   "escape": true,
  //   "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
  //   // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
  // }
}
// vim:ft=jsonc
